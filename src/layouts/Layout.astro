---                               
import '../styles/global.css'
---

<html lang="es">
<head>

  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta charset="UTF-8"/>

  <!-- Título y descripción -->
  <title>Vladimir Valladares | Consultor & Pedagogo</title>
  <meta name="description"
        content="Resumen profesional de Vladimir Valladares: pedagogo, consultor educativo y diseñador de ambientes de aprendizaje con 20 años de experiencia." />

  <!-- Favicon & App Icons -->
  <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} sizes="any" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Color de la UI (barras del SO) -->
  <meta name="theme-color" content="#0891B2" />

  <!-- ------------------------------------------------- -->
  <!-- OPEN GRAPH / REDES SOCIALES                        -->
  <!-- ------------------------------------------------- -->
  <meta property="og:type"        content="website" />
  <meta property="og:locale"      content="es_PA" />       
  <meta property="og:url"         content="https://didaskalia.org/vladimirvalladares/" />
  <meta property="og:title"       content="Vladimir Valladares | Consultor & Pedagogo" />
  <meta property="og:description" content="esumen profesional de Vladimir Valladares: pedagogo, consultor educativo y diseñador de ambientes de aprendizaje con 20 años de experiencia." />
  <meta property="og:image"       content="https://didaskalia.org/vladimirvalladares/assets/img/og-cover.png" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:creator"     content="@Vladmirvallad" />
  <meta name="twitter:title"       content="Vladimir Valladares | Consultor & Pedagogo" />
  <meta name="twitter:description" content="esumen profesional de Vladimir Valladares: pedagogo, consultor educativo y diseñador de ambientes de aprendizaje con 20 años de experiencia." />
  <meta name="twitter:image"       content="https://didaskalia.org/vladimirvalladares/assets/img/og-cover.png" />

  <!-- Canonical para evitar duplicados -->
  <link rel="canonical" href="https://didaskalia.org/vladimirvalladares/" />

  <!-- ------------------------------------------------- -->
  <!-- RENDIMIENTO                                        -->
  <!-- ------------------------------------------------- -->
  <!-- Pre-conexión a Google Fonts (si las usas) -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <!-- Preload de tu fuente principal -->
  <link rel="preload"
        href="/fonts/raleway-latin-variable.woff2"
        as="font" type="font/woff2" crossorigin />

  <!-- Preload de la imagen hero / portada -->
  <link rel="preload"
        href="/assets/img/hero-bg.webp"
        as="image" type="image/webp" fetchpriority="high" />

 
</head>

<body >
  <main class="">
    <slot />
  </main>
</body>
</html>
