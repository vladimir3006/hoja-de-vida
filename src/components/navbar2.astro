---
---

<nav id="mainNavbar" class="fixed inset-x-0 top-0 z-50 pointer-events-auto">

  <!-- GRID:   -->
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8
              grid  place-items-center py-3">

    <!-- 1 ▸ Hamburguesa (celda izquierda, se alinea sola) -->
    <button id="menuToggle"
            class="md:hidden justify-self-end w-9 h-9 grid place-content-center
                   rounded-lg ring-1 ring-inset ring-slate-700/10 dark:ring-white/10
                   hover:bg-slate-700/5 dark:hover:bg-white/10 transition"
            aria-label="Abrir menú">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- 2 ▸ Links desktop (celda central) -->
    <nav id="menuItems" class="hidden md:flex  space-x-8">
      <a href="#hero"     class="navlink">Inicio</a>
      <a href="#aboutme"  class="navlink">Sobre mí</a>
      <a href="#resumem"  class="navlink">Resumen</a>
      <a href="#services" class="navlink">Servicios</a>
      <a href="#contact"  class="navlink">Contacto</a>
    </nav>

    <!-- 3 ▸ Placeholder de ancho 1fr (invisible) -->
    <div aria-hidden="true"></div>
  </div>

  <!-- Menú móvil ➜ ABSOLUTE para salir del flujo -->
  <div id="mobileMenu"
       class="absolute inset-x-0 top-full md:hidden 
              backdrop-blur-lg bg-white dark:bg-slate-900/80
              ring-1 ring-white/20 dark:ring-white/10 rounded-b-xl shadow-lg
              origin-top transition-transform duration-300
              data-[open=false]:scale-y-0 data-[open=false]:opacity-0">
    <ul class="py-2">
      <li><a href="#hero"     class="mobile-link">Inicio</a></li>
      <li><a href="#aboutme"  class="mobile-link">Sobre mí</a></li>
      <li><a href="#resumem"  class="mobile-link">Resumen</a></li>
      <li><a href="#services" class="mobile-link">Servicios</a></li>
      <li><a href="#contact"  class="mobile-link">Contacto</a></li>
    </ul>
  </div>
  
</nav>

<style is:global>
/* ---------- nav base transparente ---------- */
#mainNavbar{
  background:transparent;
  backdrop-filter:none;
  box-shadow:none;
  transition:background .3s, backdrop-filter .3s, box-shadow .3s;
}

/* ---------- glass cuando se hace scroll ---------- */
#mainNavbar.scrolled{
  background:rgba(255,255,255,.70);
  backdrop-filter:blur(16px);
  box-shadow:0 6px 20px -4px rgba(0,0,0,.10);
  border-bottom:1px solid rgba(255,255,255,.40);
}
html.dark #mainNavbar.scrolled{
  background:rgba(15,23,42,.70);
  border-bottom-color:rgba(255,255,255,.10);
}

/* ---------- links desktop ---------- */
.navlink{
  position:relative;
  font-weight:500;
  letter-spacing:.02em;
  color:#334155;
  transition:color .3s;
}
html.dark .navlink{ color:#E2E8F0; }

.navlink:hover{ color:#104e64; }
html.dark .navlink:hover{ color:#22D3EE; }

.navlink::after{
  content:'';
  position:absolute;
  left:0; right:0; bottom:-4px;
  height:2px;
  background:linear-gradient(to right,#06B6D4,#2DD4BF);
  border-radius:9999px;
  transform:scaleX(0);
  transform-origin:center;
  transition:transform .3s;
}
.navlink:hover::after,
.navlink.active::after{ transform:scaleX(1); }

.navlink.active{ color:#0891B2; }
html.dark .navlink.active{ color:#22D3EE; }

/* ---------- links móvil ---------- */
.mobile-link{
  display:block;
  padding:12px 24px;
  border-radius:0.5rem;
  color:#334155;
  transition:background-color .2s;
}
html.dark .mobile-link{ color:#E2E8F0; }

.mobile-link:hover{ background:#104e64; color:white;  transition:all .3s;}
html.dark .mobile-link:hover{ background:#1E293B; }
</style>


<script is:inline>
/* helper */
const ready = fn =>
  document.readyState==='loading'
    ? document.addEventListener('DOMContentLoaded',fn,{once:true})
    : fn();

ready(()=>{
  /* glass dinámico */
  const scroller=document.getElementById('pageScroller');
  const nav=document.getElementById('mainNavbar');
  const handle=()=>nav.classList.toggle('scrolled',scroller.scrollTop>50);
  handle();
  scroller.addEventListener('scroll',handle,{passive:true});
  document.addEventListener('astro:page-load',handle);

  /* menú móvil */
  const btn=document.getElementById('menuToggle');
  const menu=document.getElementById('mobileMenu');
  let open=false;
  const sync=()=>{
    menu.dataset.open=open;
    document.body.classList.toggle('overflow-hidden',open);
  };
  btn.addEventListener('click',()=>{open=!open;sync();});
  menu.querySelectorAll('a').forEach(a=>
    a.addEventListener('click',()=>{open=false;sync();})
  );
  sync();
});
</script>
