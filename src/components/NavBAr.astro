---
import HomeIcon from "../components/icons/HomeIcon.astro";
import UserIcon from "../components/icons/UserIcon.astro";
import ResumeIcon from "../components/icons/ResumeIcon.astro";
import ServicesIcon from "../components/icons/ServicesIcon.astro";
import ContactIcon from "../components/icons/ContactIcon.astro";



---

    <nav id="mainNavbar" class="fixed top-0 left-0 w-full z-50 ">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center py-3">
    
    

    <!-- Botón hamburguesa -->
    <button id="menuToggle" class="md:hidden text-slate-800 hover:text-cyan-700 focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Enlaces de navegación -->
    <div id="menuItems" class="hidden md:flex space-x-6 text-slate-800 font-medium">
      <a href="#hero" class="hover:text-cyan-700 transition">Inicio</a>
      <a href="#aboutme" class="hover:text-cyan-700 transition">Sobre mí</a>
      <a href="#resumem" class="hover:text-cyan-700 transition">Resumen</a>
      <a href="#services" class="hover:text-cyan-700 transition">Servicios</a>
      <a href="#contact" class="hover:text-cyan-700 transition">Contacto</a>
    </div>
  </div>

  <!-- Menú móvil (oculto por defecto) -->
  <div id="mobileMenu" class="md:hidden hidden px-4 pb-4">
    <ul class="space-y-2 text-slate-800 font-medium">
      <li><a href="#hero" class="block hover:text-cyan-700">Inicio</a></li>
      <li><a href="#aboutme" class="block hover:text-cyan-700">Sobre mí</a></li>
      <li><a href="#resumem" class="block hover:text-cyan-700">Resumen</a></li>
      <li><a href="#services" class="block hover:text-cyan-700">Servicios</a></li>
      <li><a href="#contact" class="block hover:text-cyan-700">Contacto</a></li>
    </ul>
  </div>
</nav>


<style is:global>
  #mainNavbar {
    transition: all 0.3s ease-in-out;
    background: transparent;
  }

  .scrolled {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    box-shadow:
      0 5px 50px -5px rgba(255, 255, 255, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }
</style>


<script is:inline>

    document.addEventListener("DOMContentLoaded", () => {
    const toggleBtn = document.getElementById("menuToggle");
    const mobileMenu = document.getElementById("mobileMenu");
    const navbar = document.getElementById("mainNavbar");

    // Toggle del menú móvil
    toggleBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
    });
        
  });
  /** Ejecuta fn cuando el DOM esté listo (a prueba de timing) */
  function onDomReady(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn, { once: true });
    } else {
      // 'interactive' o 'complete'
      fn();
    }
  }

  onDomReady(() => {
    const scroller = document.getElementById('pageScroller');
    const navbar   = document.getElementById('mainNavbar');
    if (!scroller || !navbar) return;   // por si falla el id

    const handle = () =>
      navbar.classList.toggle('scrolled', scroller.scrollTop > 50);

    handle();                           // estado inicial
    scroller.addEventListener('scroll', handle, { passive: true });

    // Si usas las view-transitions de Astro (SPA)
    document.addEventListener('astro:page-load', handle);
  });
</script>



 