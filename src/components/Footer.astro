---
import SocialNetworks from "../components/UI/SocialNetworks.astro";

import FacebookIcon from "../components/icons/FacebookIcon.astro";
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";
import PortfolioIcon from "../components/icons/PortfolioIcon.astro";
import WebIcon from "../components/icons/WebIcon.astro";
const redes = [
  {
    title: "Facebook Page",
    icon: FacebookIcon,
    enlace: "https://www.facebook.com/vladimir.valladares.37/"
  },
  {
    title: "Instagram Page",
    icon: InstagramIcon,
    enlace: "https://www.instagram.com/vladimir.valladares/"
  },
  {
    title: "LinkedIn Page",
    icon: LinkedInIcon,
    enlace: "https://www.linkedin.com/in/vladimirvalladares/"
  },
  {
    title: "Web Page",
    icon: WebIcon,
    enlace: "https://didaskalia.org/"
  },
  {
    title: "Porfolio",
    icon: PortfolioIcon,
    enlace: "https://didaskalia.org/portafolio/"
  }
];
---

<footer id="footer" class="snap-start min-h-[50vh] flex flex-col justify-center items-center px-4 py-10 bg-slate-50 text-center">
    
    <h2 class="text-4xl text-slate-700 font-raleway font-bold mb-6 ">Vladimir Valladares</h2>
    <p class="text-base text-slate-700 mb-6 italic">"Creo que hay que amar la vida por encima de todo, sin lógica, solo así comprenderá su verdadero sentido."</p>

        <SocialNetworks 
            datos={redes}
            containerClass="flex justify-center gap-x-8 text-white mb-6 "
            linkClass=" bg-cyan-800 rounded-full hover:bg-cyan-700"
            iconClass="size-10 p-2 "/>

            <p>Año <span id="year"></span></p>


</footer>

<script>
    document.addEventListener("DOMContentLoaded", () => {
      const yearEl = document.getElementById("year");
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }
    });
  </script>
</footer>